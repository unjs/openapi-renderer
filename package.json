{
  "name": "openapi-renderer",
  "version": "0.1.1",
  "description": "Simple OpenAPI spec to HTML renderer",
  "repository": "unjs/openapi-renderer",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "obuild",
    "dev": "node --experimental-strip-types --watch playground/index.mjs",
    "lint": "eslint . && prettier -c .",
    "lint:fix": "automd && eslint . --fix && prettier -w .",
    "prepack": "pnpm build",
    "release": "pnpm test && changelogen --release && npm publish && git push --follow-tags",
    "test": "pnpm lint && pnpm test:types && vitest run --coverage",
    "test:types": "tsc --noEmit --skipLibCheck"
  },
  "devDependencies": {
    "@kong/spec-renderer": "^1.115.3",
    "@scalar/api-reference": "^1.73.0",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^3.2.7",
    "automd": "^0.4.3",
    "changelogen": "^0.6.2",
    "eslint": "^9.39.5",
    "eslint-config-unjs": "^0.6.2",
    "obuild": "^0.4.43",
    "prettier": "^3.9.9",
    "srvx": "^0.12.8",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "@kong/spec-renderer": "^1.115.3",
    "@scalar/api-reference": "^1.73.0"
  },
  "peerDependenciesMeta": {
    "@kong/spec-renderer": {
      "optional": true
    },
    "@scalar/api-reference": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.34.6"
}
