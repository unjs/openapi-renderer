{
  "name": "openapi-renderer",
  "version": "0.1.1",
  "description": "Simple OpenAPI spec to HTML renderer",
  "license": "MIT",
  "repository": "unjs/openapi-renderer",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs"
  },
  "scripts": {
    "build": "obuild",
    "dev": "node --experimental-strip-types --watch playground/index.mjs",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "automd && oxlint . --fix && oxfmt .",
    "prepack": "pnpm build",
    "release": "pnpm test && changelogen --release && npm publish && git push --follow-tags",
    "test": "pnpm lint && pnpm test:types && vitest run --coverage",
    "test:types": "tsgo --noEmit --skipLibCheck"
  },
  "devDependencies": {
    "@kong/spec-renderer": "^1.107.12",
    "@scalar/api-reference": "^1.52.2",
    "@types/node": "^25.6.0",
    "@typescript/native-preview": "7.0.0-dev.20260416.2",
    "@vitest/coverage-v8": "^4.1.4",
    "automd": "^0.4.3",
    "changelogen": "^0.6.2",
    "eslint-config-unjs": "^0.6.2",
    "obuild": "^0.4.33",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "srvx": "^0.11.15",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "@kong/spec-renderer": "^1",
    "@scalar/api-reference": "^1"
  },
  "peerDependenciesMeta": {
    "@kong/spec-renderer": {
      "optional": true
    },
    "@scalar/api-reference": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.33.0"
}
